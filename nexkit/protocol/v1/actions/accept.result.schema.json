{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/accept.result.schema.json",
  "$comment": "The result of accept, in actionFinished.",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "refusal": {
      "anyOf": [
        {
          "enum": [
            "transient",
            "waitingForChecks",
            "checkFailed",
            "behind",
            "headMoved",
            "conflict",
            "notAccepted",
            "needsPerson"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "type": "string"
    },
    "baseFailure": {
      "$comment": "For a refusal as `checkFailed`: the work item about a failure the base branch has, when every required check that failed fails as it does there, as the host compares them; null or left out otherwise. The fix round waits for that failure to end rather than fix it again.",
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "accepted",
    "refusal",
    "text"
  ]
}
