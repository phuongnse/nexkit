{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/accept.schema.json",
  "$comment": "Accept the change: such as a merge or an accept of a draft.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "accept"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeVersion": {
      "type": "string"
    },
    "by": {
      "enum": [
        "engine",
        "person"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "changeVersion",
    "by"
  ]
}
