{
  "$comment": "Stop an action that runs. A result that comes after it is ignored.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "cancel"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "$ref": "../common.schema.json#/$defs/id"
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "action"
  ],
  "additionalProperties": false
}
