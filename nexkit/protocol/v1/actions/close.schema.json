{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/actions/close.schema.json",
  "$comment": "End the work item.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "close"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "notPlanned"
      ]
    },
    "finding": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "outcome",
    "finding"
  ]
}
