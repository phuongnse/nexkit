{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/actions/createParts.result.schema.json",
  "$comment": "The result of createParts, in actionFinished.",
  "type": "object",
  "properties": {
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "integer"
          },
          "item": {
            "$ref": "../common.schema.json#/$defs/id"
          }
        },
        "required": [
          "key",
          "item"
        ]
      }
    }
  },
  "required": [
    "parts"
  ]
}
