{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/needPerson.schema.json",
  "$comment": "Tell the people who decide, once, with what they decide on (`ref`, as attention has it).",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "needPerson"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "$ref": "../common.schema.json#/$defs/attentionReason"
    },
    "text": {
      "type": "string"
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "reason",
    "text",
    "ref"
  ]
}
