{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/publish.result.schema.json",
  "$comment": "The result of publish, in actionFinished.",
  "type": "object",
  "properties": {
    "change": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "refused": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "change",
    "refused"
  ]
}
