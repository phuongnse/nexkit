{
  "$comment": "Make the agent's work the change: a commit and a pull request, or a draft.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "publish"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "enum": [
        "implement",
        "fix"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "stage"
  ],
  "additionalProperties": false
}
