{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/runAgent.result.schema.json",
  "$comment": "The result of runAgent, in actionFinished. `changeVersion` is the version the session produced; `timedOut` says it ran out of its time; `seconds` and `usd` are what it spent, null when not known.",
  "type": "object",
  "properties": {
    "output": {
      "type": [
        "object",
        "null"
      ]
    },
    "tokens": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/tokens"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "reset": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message",
            "reset"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "transient": {
      "type": "boolean"
    },
    "noResult": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "changeVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "timedOut": {
      "type": "boolean"
    },
    "seconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "usd": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "output",
    "tokens",
    "limit",
    "transient",
    "noResult",
    "error",
    "session",
    "changeVersion",
    "timedOut",
    "seconds",
    "usd"
  ]
}
