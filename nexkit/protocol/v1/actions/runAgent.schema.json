{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/runAgent.schema.json",
  "$comment": "Run one agent session for a stage, on `changeVersion` of the change, or with no change when null. `result` names the stage's result schema; `inputs` name what `prompt` needs.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "runAgent"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "$ref": "../common.schema.json#/$defs/stage"
    },
    "changeVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "access": {
      "enum": [
        "none",
        "read",
        "write"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "enum": [
          "item",
          "discussion",
          "notes",
          "plan",
          "previousPlan",
          "checks",
          "linked",
          "evidence",
          "parts",
          "diff",
          "workspace"
        ]
      }
    },
    "result": {
      "type": "string"
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seconds": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "tokens",
        "seconds"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "resume": {
      "type": "boolean"
    },
    "diagnose": {
      "$comment": "For a fix round, the checks it looks into first: for an automatic fix round, those that failed with the same signature before and after the fix round before it; empty for any other fix round. Left out for the other stages.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "by": {
      "$comment": "Left out for work the engine started by itself. A person's work, and the rest of that round (its publish, checks and review), carry \"person\": when lost, it waits for a person at once.",
      "enum": [
        "person"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "stage",
    "changeVersion",
    "access",
    "inputs",
    "result",
    "agent",
    "model",
    "effort",
    "budget",
    "session",
    "resume"
  ]
}
