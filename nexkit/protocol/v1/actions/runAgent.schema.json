{
  "$comment": "Run one agent session for a stage. `result` names the stage's result schema; `inputs` name what `prompt` needs.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "runAgent"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "$ref": "../common.schema.json#/$defs/stage"
    },
    "access": {
      "enum": [
        "none",
        "read",
        "write"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "enum": [
          "item",
          "discussion",
          "notes",
          "plan",
          "previousPlan",
          "rounds",
          "checks",
          "findings",
          "linked",
          "evidence",
          "parts",
          "diff"
        ]
      }
    },
    "result": {
      "type": "string"
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "tokens",
        "seconds",
        "usd"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "resume": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "stage",
    "access",
    "inputs",
    "result",
    "agent",
    "model",
    "effort",
    "budget",
    "session",
    "resume"
  ],
  "additionalProperties": false
}
