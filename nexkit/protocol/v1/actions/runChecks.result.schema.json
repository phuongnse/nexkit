{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/runChecks.result.schema.json",
  "$comment": "The result of runChecks, in actionFinished.",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "skipped": {
            "type": "boolean"
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "knownBaseFailure": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "passed",
          "skipped",
          "signature",
          "knownBaseFailure"
        ]
      }
    },
    "baseFailure": {
      "$comment": "The work item about a failure the base branch has, when every failing check fails as it does there, as the host compares them; null or left out otherwise. A fix round waits for that item to close rather than fix the same failure.",
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "checks"
  ]
}
