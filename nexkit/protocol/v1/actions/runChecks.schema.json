{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/runChecks.schema.json",
  "$comment": "Run the host's checks on a version of the change.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "runChecks"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeVersion": {
      "type": "string"
    },
    "by": {
      "$comment": "Left out for work the engine started by itself. A person's work, and the rest of that round (its publish, checks and review), carry \"person\": when lost, it waits for a person at once.",
      "enum": [
        "person"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "changeVersion"
  ]
}
