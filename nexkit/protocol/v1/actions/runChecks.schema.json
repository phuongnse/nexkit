{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/runChecks.schema.json",
  "$comment": "Run the host's checks on a version of the change.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "runChecks"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeVersion": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "changeVersion"
  ]
}
