{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/wait.schema.json",
  "$comment": "Send a tick naming the wait at its time.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "wait"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "wait": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "until": {
      "$ref": "../common.schema.json#/$defs/time"
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "wait",
    "until"
  ]
}
