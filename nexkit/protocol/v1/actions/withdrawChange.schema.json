{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/actions/withdrawChange.schema.json",
  "$comment": "End the change that a split replaces; the parts carry its work.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "withdrawChange"
    },
    "next": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "next",
    "changeId",
    "reason"
  ]
}
