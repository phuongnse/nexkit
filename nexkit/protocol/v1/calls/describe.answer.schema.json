{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/calls/describe.answer.schema.json",
  "$comment": "The answer to a describe call: the protocol's major and minor version, the engine's own version, and the calls it answers.",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "object",
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "engine": {
      "type": "string"
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "protocol",
    "engine",
    "calls"
  ]
}
