{
  "$comment": "A step call: one work item's state, null before its created event, one event and the host's policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "call",
    "state",
    "event",
    "policies"
  ],
  "properties": {
    "protocol": {
      "const": 1
    },
    "call": {
      "const": "step"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "../state.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "event": {
      "type": "object"
    },
    "policies": {
      "$ref": "../policies.schema.json"
    }
  }
}
