{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/actionFinished.schema.json",
  "$comment": "An action ended. `result` has the shape of the action kind's result schema.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "actionFinished"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "action": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "changeVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "action",
    "changeVersion",
    "result"
  ]
}
