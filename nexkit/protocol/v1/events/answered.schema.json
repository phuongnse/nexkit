{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/answered.schema.json",
  "$comment": "A person answers the questions of the plan that `plan` names, or of a round's, counting from 1. Answers to another plan, or when no question is open, change nothing.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "answered"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "by": {
      "$ref": "../common.schema.json#/$defs/person"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "integer"
          },
          "option": {
            "type": "integer"
          }
        },
        "required": [
          "question",
          "option"
        ]
      }
    },
    "note": {
      "type": "string"
    },
    "plan": {
      "$ref": "../common.schema.json#/$defs/planRef"
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "by",
    "answers",
    "note",
    "plan"
  ]
}
