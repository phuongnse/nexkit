{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/blockerClosed.schema.json",
  "$comment": "A work item that this one waits for ended.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "blockerClosed"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "blocker": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "completed": {
      "type": "boolean"
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "blocker",
    "completed"
  ]
}
