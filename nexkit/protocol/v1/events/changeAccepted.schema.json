{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/changeAccepted.schema.json",
  "$comment": "The change went in outside the engine, such as a merge by hand.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "changeAccepted"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "changeVersion": {
      "type": "string"
    },
    "by": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/person"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "changeVersion",
    "by"
  ]
}
