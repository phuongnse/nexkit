{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/events/changeEmptied.schema.json",
  "$comment": "The change changes nothing any more, because the same change landed another way.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "changeEmptied"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "changeVersion": {
      "type": "string"
    },
    "landedIn": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "changeVersion",
    "landedIn"
  ]
}
