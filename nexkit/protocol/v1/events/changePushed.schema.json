{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/changePushed.schema.json",
  "$comment": "A person changed the change, from `previousVersion` to `changeVersion`. Pushes may arrive in any order: one that does not start from the current version waits in the state until the change reaches its `previousVersion`.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "changePushed"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "previousVersion": {
      "type": "string"
    },
    "changeVersion": {
      "type": "string"
    },
    "by": {
      "$ref": "../common.schema.json#/$defs/person"
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "previousVersion",
    "changeVersion",
    "by"
  ]
}
