{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/conflict.schema.json",
  "$comment": "The change no longer applies to what it was made on.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "conflict"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "changeVersion": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "changeVersion",
    "files"
  ]
}
