{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/events/created.schema.json",
  "$comment": "A work item is made. An item made with its plan, such as by an outside app, starts in awaitingApproval; a review-only item, such as a change a person made themselves, comes with its change.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "created"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "itemKind": {
      "enum": [
        "change",
        "reviewOnly"
      ]
    },
    "title": {
      "type": "string",
      "$comment": "The work item's title, which the parts of a split may not repeat. The state keeps its first 256 characters."
    },
    "depth": {
      "$comment": "For a part of a split, how many levels it is below the item first split; 0, or left out, for an item that is no part.",
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "actors": {
      "type": "object",
      "properties": {
        "plan": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "change": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "review": {
          "enum": [
            "engine"
          ]
        }
      },
      "required": [
        "plan",
        "change",
        "review"
      ]
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "../results/plan.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "change": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/id"
      },
      "maxItems": 32,
      "$comment": "The ids of the open items that block the new item: it waits for a blockerClosed of each before it starts."
    },
    "splitAsked": {
      "type": "boolean",
      "$comment": "For a part, true when its item above asked for a split after a round ran out of time: a round of the part that runs out of time waits for a person."
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "itemKind",
    "title",
    "text",
    "actors",
    "plan",
    "change"
  ]
}
