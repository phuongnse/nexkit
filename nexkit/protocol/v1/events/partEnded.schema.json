{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/events/partEnded.schema.json",
  "$comment": "A part of this work item's split ended.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "partEnded"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "part": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "state": {
      "enum": [
        "accepted",
        "noChange",
        "dropped",
        "failed"
      ]
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "part",
    "state"
  ]
}
