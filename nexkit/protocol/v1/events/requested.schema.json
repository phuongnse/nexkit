{
  "$comment": "A person, or the sweep with `by` null, asks for something.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "requested"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "what": {
      "enum": [
        "plan",
        "planFromScratch",
        "go",
        "fix",
        "review",
        "retry",
        "trust",
        "start"
      ]
    },
    "by": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/person"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string"
    },
    "title": {
      "$comment": "The work item's title as it is now, which the parts of a split may not repeat. A request that starts a plan carries it.",
      "type": "string"
    },
    "depth": {
      "$comment": "For a part of a split, how many levels it is below the item first split, 0 for an item that is no part. A request that starts a plan carries it.",
      "type": "integer"
    }
  },
  "required": [
    "protocol",
    "kind",
    "item",
    "at",
    "what",
    "by",
    "note"
  ],
  "additionalProperties": false
}
