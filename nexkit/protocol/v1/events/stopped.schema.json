{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/events/stopped.schema.json",
  "$comment": "The host stops the work item, such as for a key its provider refused.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "stopped"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "outcome": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "outcome",
    "text"
  ]
}
