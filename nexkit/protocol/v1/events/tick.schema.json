{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/events/tick.schema.json",
  "$comment": "The time of a wait came.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": 1
    },
    "kind": {
      "const": "tick"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/eventId"
    },
    "item": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/time"
    },
    "wait": {
      "$ref": "../common.schema.json#/$defs/id"
    }
  },
  "required": [
    "protocol",
    "kind",
    "id",
    "item",
    "at",
    "wait"
  ]
}
