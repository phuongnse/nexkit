{
  "$comment": "A host's policies, which come with every call. A policy left out takes its default, which is NexKit 6's on GitHub.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "planApproval": {
      "enum": [
        "person",
        "autoWhenClean"
      ]
    },
    "answers": {
      "enum": [
        "never",
        "recommended"
      ]
    },
    "reviewAfterFailingChecks": {
      "enum": [
        "always",
        "onlyAfterPassing"
      ]
    },
    "accept": {
      "enum": [
        "person",
        "autoWhenPassed"
      ]
    },
    "fixRounds": {
      "type": "integer"
    },
    "conflicts": {
      "enum": [
        "person",
        "resolve",
        "redo"
      ]
    },
    "conflictRounds": {
      "type": "integer"
    },
    "splits": {
      "type": "boolean"
    },
    "afterFailure": {
      "enum": [
        "person",
        "replan",
        "newItem"
      ]
    },
    "checklist": {
      "$comment": "Items the plan and the review answer, each a text or {text, person} for one only a person decides.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "person": {
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "profiles": {
      "$comment": "The profiles triage chooses from, each name with when it fits.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
