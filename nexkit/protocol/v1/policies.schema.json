{
  "$comment": "A host's policies, which come with every call. A policy left out takes its default, which is NexKit 6's on GitHub.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "planApproval": {
      "enum": [
        "person",
        "autoWhenClean"
      ]
    },
    "answers": {
      "enum": [
        "never",
        "recommended"
      ]
    },
    "reviewAfterFailingChecks": {
      "enum": [
        "always",
        "onlyAfterPassing"
      ]
    },
    "accept": {
      "enum": [
        "person",
        "autoWhenPassed"
      ]
    },
    "fixRounds": {
      "type": "integer"
    },
    "conflicts": {
      "enum": [
        "person",
        "resolve",
        "redo"
      ]
    },
    "conflictRounds": {
      "type": "integer"
    },
    "splits": {
      "type": "boolean"
    },
    "splitParts": {
      "$comment": "The most parts a split files; a plan with more is asked once more for fewer.",
      "type": "integer"
    },
    "splitDepth": {
      "$comment": "How deep parts go: the item first split is at depth 0, and an item at this depth is not split again.",
      "type": "integer"
    },
    "afterFailure": {
      "enum": [
        "person",
        "replan",
        "newItem"
      ]
    }
  }
}
