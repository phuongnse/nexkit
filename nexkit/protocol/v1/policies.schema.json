{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/policies.schema.json",
  "$comment": "A host's policies, which come with every call, as docs/engine.md#what-a-host-decides lists them. A policy left out takes its default, NexKit 6's on GitHub without autopilot. The page says which policies are not in this version yet.",
  "type": "object",
  "properties": {
    "planApproval": {
      "enum": [
        "person",
        "autoWhenClean"
      ],
      "default": "person"
    },
    "answers": {
      "enum": [
        "never",
        "recommended"
      ],
      "default": "never"
    },
    "reviewAfterFailingChecks": {
      "enum": [
        "always",
        "onlyAfterPassing"
      ],
      "default": "always"
    },
    "accept": {
      "enum": [
        "person",
        "autoWhenPassed"
      ],
      "default": "person"
    },
    "fixRounds": {
      "$comment": "How many fix rounds run before a person decides, from 0 to 10.",
      "type": "integer",
      "default": 2
    },
    "whenRoundsRunOut": {
      "enum": [
        "person",
        "failed"
      ],
      "default": "person"
    },
    "conflicts": {
      "enum": [
        "person",
        "resolve",
        "redo"
      ],
      "default": "person"
    },
    "conflictRounds": {
      "$comment": "How many rounds may resolve conflicts, when `conflicts` is resolve.",
      "type": "integer",
      "default": 3
    },
    "splits": {
      "$comment": "Whether an approved plan that is too large and names its parts is split into them.",
      "type": "boolean",
      "default": false
    },
    "afterFailure": {
      "enum": [
        "person",
        "replan",
        "newItem"
      ],
      "default": "person"
    }
  },
  "required": []
}
