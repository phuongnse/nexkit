{
  "$comment": "A host's policies, which come with every call. A policy left out takes its default, which is NexKit 6's on GitHub.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "planApproval": {
      "enum": [
        "person",
        "autoWhenClean"
      ]
    },
    "answers": {
      "enum": [
        "never",
        "recommended"
      ]
    },
    "reviewAfterFailingChecks": {
      "enum": [
        "always",
        "onlyAfterPassing"
      ]
    },
    "accept": {
      "enum": [
        "person",
        "autoWhenPassed"
      ]
    },
    "fixRounds": {
      "type": "integer"
    },
    "conflicts": {
      "enum": [
        "person",
        "resolve",
        "redo"
      ]
    },
    "conflictRounds": {
      "type": "integer"
    },
    "splits": {
      "type": "boolean"
    },
    "afterFailure": {
      "enum": [
        "person",
        "replan",
        "newItem"
      ]
    },
    "checklist": {
      "$comment": "Items the plan and the review answer, each a text or {text, person} for one only a person decides.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "person": {
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "profiles": {
      "$comment": "The profiles triage chooses from: each name, with when it fits.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string"
          }
        },
        "required": [
          "when"
        ]
      }
    },
    "budgets": {
      "$comment": "What each stage may spend, by stage. The plan prompt names the implement stage's time.",
      "type": "object",
      "properties": {
        "triage": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "usd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "usd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "implement": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "usd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "fix": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "usd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "usd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
