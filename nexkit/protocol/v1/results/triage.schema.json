{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phuongnse/nexkit/main/nexkit/protocol/v1/results/triage.schema.json",
  "$comment": "The triage stage's result. A host adds its profile names to `profile` as an enum.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "profile",
    "reason"
  ]
}
