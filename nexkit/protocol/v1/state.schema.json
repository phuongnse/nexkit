{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/state.schema.json",
  "$comment": "One work item's state document, which the host stores and passes back. It holds decisions, not prose.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer"
    },
    "item": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "itemKind": {
      "enum": [
        "change",
        "reviewOnly"
      ]
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "change": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed": {
      "$comment": "The latest observation of the item's change, from changeObserved or from the result of a publish or replace, or null. The engine reconciles the item with it after each event that changes the state (docs/engine.md#states).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "changeId": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "conflicts": {
              "type": "boolean"
            },
            "merged": {
              "type": "boolean"
            },
            "empty": {
              "type": "boolean"
            }
          },
          "required": [
            "changeId",
            "version",
            "conflicts",
            "merged",
            "empty"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attention": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "common.schema.json#/$defs/attentionReason"
            },
            "text": {
              "type": "string"
            },
            "ref": {
              "$comment": "What the person decides on: the ref of the text that asked, for a question or an approval; null otherwise. A decision that names another changes nothing.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "text",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hold": {
      "type": "boolean"
    },
    "waits": {
      "type": "array",
      "items": {
        "$comment": "Each wait's id is new each time; a tick ends only a wait for a time (`time`, `usageLimit`, `requiredChecks`).",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "for": {
            "enum": [
              "start",
              "time",
              "usageLimit",
              "blocker",
              "parts",
              "baseFailure",
              "requiredChecks"
            ]
          },
          "until": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "on": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "for",
          "until",
          "on"
        ],
        "additionalProperties": false
      }
    },
    "pending": {
      "$comment": "The outbox: each action the engine answered, whole, until its result, its cancel or its loss.",
      "type": "array",
      "items": {
        "$ref": "action.schema.json"
      }
    },
    "actors": {
      "type": "object",
      "properties": {
        "plan": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "change": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "review": {
          "enum": [
            "engine"
          ]
        }
      },
      "required": [
        "plan",
        "change",
        "review"
      ],
      "additionalProperties": false
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/question"
              }
            },
            "criteria": {
              "type": "integer"
            },
            "tooLarge": {
              "type": "boolean"
            },
            "parts": {
              "type": "integer"
            },
            "noChange": {
              "type": "boolean"
            },
            "protectedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approved": {
              "type": "boolean"
            },
            "split": {
              "$comment": "The parts a split plan names, with the earlier parts each needs, by key.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "needs": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "key",
                  "title",
                  "needs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "text",
            "questions",
            "criteria",
            "tooLarge",
            "parts",
            "noChange",
            "protectedPaths",
            "approved",
            "split"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rounds": {
      "type": "object",
      "properties": {
        "started": {
          "type": "integer"
        },
        "counted": {
          "type": "integer"
        },
        "conflicts": {
          "type": "integer"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "blocking",
                  "suggestion"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "unmet",
              "unverifiable"
            ]
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "not_met",
              "not_applicable"
            ]
          }
        }
      },
      "required": [
        "started",
        "counted",
        "conflicts",
        "signatures",
        "findings",
        "criteria",
        "checklist"
      ],
      "additionalProperties": false
    },
    "used": {
      "$comment": "What the item's agents spent: tokens, seconds and US dollars.",
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "common.schema.json#/$defs/tokens"
        },
        "seconds": {
          "type": "integer"
        },
        "usd": {
          "type": "number"
        },
        "since": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokens",
        "seconds",
        "usd",
        "since"
      ],
      "additionalProperties": false
    },
    "asked": {
      "type": "array",
      "items": {
        "enum": [
          "split",
          "titles",
          "parts",
          "fewer",
          "answers"
        ]
      }
    },
    "parts": {
      "$comment": "The parts of a split, and how each ended, or null while it is open.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "state": {
            "anyOf": [
              {
                "enum": [
                  "accepted",
                  "noChange",
                  "dropped",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "policies": {
      "$comment": "The policies the running round started with, so that a change of the host's configuration applies from the next round. Empty while no round runs. Only the policies of policies.schema.json, each as it has it.",
      "type": "object",
      "properties": {
        "planApproval": {
          "$ref": "policies.schema.json#/properties/planApproval"
        },
        "reviewAfterFailingChecks": {
          "$ref": "policies.schema.json#/properties/reviewAfterFailingChecks"
        },
        "accept": {
          "$ref": "policies.schema.json#/properties/accept"
        },
        "fixRounds": {
          "$ref": "policies.schema.json#/properties/fixRounds"
        },
        "whenRoundsRunOut": {
          "$ref": "policies.schema.json#/properties/whenRoundsRunOut"
        },
        "conflicts": {
          "$ref": "policies.schema.json#/properties/conflicts"
        },
        "conflictRounds": {
          "$ref": "policies.schema.json#/properties/conflictRounds"
        },
        "splits": {
          "$ref": "policies.schema.json#/properties/splits"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "recentEvents": {
      "$comment": "The ids of the latest events that changed the state, newest last, at most 20. An event whose id is here changes nothing.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/eventId"
      },
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "item",
    "itemKind",
    "state",
    "change",
    "observed",
    "attention",
    "hold",
    "waits",
    "pending",
    "actors",
    "plan",
    "rounds",
    "used",
    "asked",
    "parts",
    "policies",
    "recentEvents"
  ],
  "additionalProperties": false
}
