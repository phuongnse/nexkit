{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/state.schema.json",
  "$comment": "One work item's state document, which the host stores and passes back. It holds decisions and the history that the prompts show, not other prose. As `protocol.size` measures it, JSON in UTF-8 with sorted keys and no spaces, it is at most 48,000 bytes, so that its base64 fits a text field of 65,536 characters. Each list the results and events fill has the most items it keeps (`maxItems`), and its texts are clipped as they come in. When a document would still pass the limit, the engine shortens the findings, the questions and options, the protected list, the attention's text and the repeated checks' names, then the last review's findings, the fix records' texts and, last, the names and signatures of the checks and the conflicting files in them, to fit, and, if that is not enough, the oldest fix records leave out the checks that still failed after them.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer"
    },
    "item": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "itemKind": {
      "enum": [
        "change",
        "reviewOnly"
      ]
    },
    "title": {
      "$comment": "The work item's title, at most 256 characters, as `created` gave it or a request gave it again: the parts of a split may not repeat it. Left out when no event gave it.",
      "type": "string",
      "maxLength": 256
    },
    "depth": {
      "$comment": "How many levels of parts the item is below the item first split, as `created` gave it or a request gave it again; 0 when left out.",
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "change": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed": {
      "$comment": "The latest observation of the item's change, from changeObserved or from the result of a publish or replace, or null. The engine reconciles the item with it after each event that changes the state (docs/engine-states.md#states).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "changeId": {
              "$ref": "common.schema.json#/$defs/observation/properties/changeId"
            },
            "version": {
              "$ref": "common.schema.json#/$defs/observation/properties/version"
            },
            "conflicts": {
              "$ref": "common.schema.json#/$defs/observation/properties/conflicts"
            },
            "merged": {
              "$ref": "common.schema.json#/$defs/observation/properties/merged"
            },
            "empty": {
              "$ref": "common.schema.json#/$defs/observation/properties/empty"
            },
            "behind": {
              "$ref": "common.schema.json#/$defs/observation/properties/behind"
            },
            "acceptable": {
              "$ref": "common.schema.json#/$defs/observation/properties/acceptable"
            }
          },
          "required": [
            "changeId",
            "version",
            "conflicts",
            "merged",
            "empty"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attention": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "common.schema.json#/$defs/attentionReason"
            },
            "text": {
              "type": "string"
            },
            "ref": {
              "$comment": "What the person decides on: the ref of the text that asked, for a question or an approval; null otherwise. A decision that names another changes nothing.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "text",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hold": {
      "type": "boolean"
    },
    "refusedAcceptable": {
      "$comment": "The version whose accept was refused while the latest observation of it said it was acceptable (`acceptable`): the engine does not accept it again for that observation, since a second refusal of it would only repeat (docs/engine-states.md#states). The engine drops it when the item's version changes. Left out when there is none.",
      "$ref": "common.schema.json#/$defs/change/properties/version"
    },
    "checksSince": {
      "$comment": "When the first accept on `version` was refused because required checks had not passed, while the item stays in `accepting`: the wait for them ends six hours after it (docs/engine-states.md#states). A start recorded for another version counts as missing, and the engine drops it when the item leaves `accepting`.",
      "type": "object",
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/change/properties/version"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/time"
        }
      },
      "required": [
        "version",
        "at"
      ],
      "additionalProperties": false
    },
    "waits": {
      "type": "array",
      "items": {
        "$comment": "Each wait's id is new each time; a tick ends only a wait for a time (`time`, `usageLimit`, `requiredChecks`).",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "for": {
            "enum": [
              "start",
              "time",
              "usageLimit",
              "blocker",
              "parts",
              "baseFailure",
              "requiredChecks"
            ]
          },
          "until": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "on": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "for",
          "until",
          "on"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "pending": {
      "$comment": "The outbox: each action the engine answered, whole, until its result, its cancel or its loss.",
      "type": "array",
      "items": {
        "$ref": "action.schema.json"
      },
      "maxItems": 64
    },
    "actors": {
      "type": "object",
      "properties": {
        "plan": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "change": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "review": {
          "enum": [
            "engine"
          ]
        }
      },
      "required": [
        "plan",
        "change",
        "review"
      ],
      "additionalProperties": false
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "questions": {
              "type": "array",
              "items": {
                "$comment": "A question as the state keeps it. `recommended` and `closes` count options from 1; 0 is none.",
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 6
                  },
                  "recommended": {
                    "type": "integer"
                  },
                  "closes": {
                    "type": "integer"
                  }
                },
                "required": [
                  "question",
                  "options",
                  "recommended"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            },
            "criteria": {
              "type": "integer"
            },
            "tooLarge": {
              "type": "boolean"
            },
            "parts": {
              "$comment": "How many parts the plan names, which may be more than `split` keeps.",
              "type": "integer"
            },
            "noChange": {
              "type": "boolean"
            },
            "protected": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "approved": {
              "type": "boolean"
            },
            "split": {
              "$comment": "The parts a split plan names, with the earlier parts each needs, by key.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "needs": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "maxItems": 9
                  }
                },
                "required": [
                  "key",
                  "title",
                  "needs"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            }
          },
          "required": [
            "text",
            "questions",
            "criteria",
            "tooLarge",
            "parts",
            "noChange",
            "protected",
            "approved",
            "split"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "$comment": "The questions of the implement or fix round that stopped as blocked and asked them, while they wait: `ref` is the agent action that asked, as attention names it, `stage` the stage that runs again with the engine's answers, and `noChange` whether the round, an implement round, found that no change is needed. Left out while no round's questions wait.",
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "stage": {
          "enum": [
            "implement",
            "fix"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$comment": "A question as the state keeps it. `recommended` and `closes` count options from 1; 0 is none. A round's question names in `replans` the options that only a new plan carries out.",
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 6
              },
              "recommended": {
                "type": "integer"
              },
              "closes": {
                "type": "integer"
              },
              "replans": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "maxItems": 6
              }
            },
            "required": [
              "question",
              "options",
              "recommended"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "noChange": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "stage",
        "items",
        "noChange"
      ],
      "additionalProperties": false
    },
    "again": {
      "$comment": "How often work ran again in this round. `transient` counts the runs again after a transient stop, until a request or a new plan, implement or fix run starts afresh. `lost` counts the starts again of an agent run or checks that the host lost, until a request or work of any kind finishes, and `once` is true when a lost run had spent tokens, so that it starts only once more. `person` is true while a person's run waits after a usage limit or a transient stop, so that it runs again as the person's. Left out while nothing counts.",
      "type": "object",
      "properties": {
        "transient": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "lost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "once": {
          "const": true
        },
        "person": {
          "const": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rounds": {
      "type": "object",
      "properties": {
        "started": {
          "type": "integer"
        },
        "counted": {
          "type": "integer"
        },
        "conflicts": {
          "type": "integer"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "blocking",
                  "suggestion"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "unmet",
              "unverifiable"
            ]
          },
          "maxItems": 50
        },
        "checklist": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "not_met",
              "not_applicable"
            ]
          },
          "maxItems": 50
        },
        "baseFailure": {
          "$comment": "The item about a failure the base branch has that every failing check of the latest checks matches, as their result names it, or null: a fix round waits for it to close.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "recheck": {
          "$comment": "The version of the change that a fix round left as it was, having found the cause outside it, while it is the change's version: what still fails on it is a person's.",
          "$ref": "common.schema.json#/$defs/id"
        },
        "due": {
          "$comment": "An automatic fix round was decided and waits to be issued, for a hold or a failure the base branch has: it is counted when its run is issued, while `fixRounds` has one left by the policies given then.",
          "const": true
        },
        "automatic": {
          "$comment": "The fix round under way is an automatic one that `counted` holds, until its review ends: one that the engine stops before then gives its count back, such as when a conflict round takes over or a person makes a new version while its agent runs. A person's new version after the round published keeps the count.",
          "const": true
        },
        "failing": {
          "$comment": "The checks that failed in the latest checks, each as a short digest of its name and failure signature (`protocol.size.failure_key`): the checks after a fix round compare with them. Left out when none failed.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "maxItems": 300
        },
        "repeated": {
          "$comment": "The checks that failed with the same signature before and after the latest fix round, by name: the next automatic fix round diagnoses the first ten (`runAgent`'s `diagnose`). Left out when none did.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 150
        },
        "fixed": {
          "$comment": "The version of the change that a fix round published, until its checks end: those checks are compared with the ones before it.",
          "$ref": "common.schema.json#/$defs/id"
        },
        "updates": {
          "$comment": "The updates of a change that is behind its base, counted apart from `conflicts`, and limited by `conflictRounds` as those are. Left out at 0.",
          "type": "integer"
        },
        "fixRound": {
          "$comment": "The fix round under way, until its agent returns a result that is not blocked and the engine records it in `fixes`: who started it, whether it diagnoses, and its note, clipped to 2,000 characters.",
          "type": "object",
          "properties": {
            "auto": {
              "type": "boolean"
            },
            "diagnosis": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "auto",
            "diagnosis",
            "note"
          ],
          "additionalProperties": false
        },
        "fixes": {
          "$comment": "The latest five fix rounds, oldest first, as the fix prompt shows them: `round` is the engine's count of started rounds, or the next number after a record of a host's first document; `auto` whether the engine started it, `diagnosis` whether it looked into repeated checks; the note, the agent's summary and the cause it found are clipped to 2,000, 4,000 and 2,000 characters. `failing` lists the checks that still failed after the round, by name and failure signature (at most 200 characters), and is left out until its checks end; empty when every check passed. `conflicts` names the files of a merge of the base branch that conflicted, which only a record of a host's first document has. Left out until the first round.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": {
                "type": "integer"
              },
              "auto": {
                "type": "boolean"
              },
              "diagnosis": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "cause": {
                "type": "string"
              },
              "failing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "signature"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30
              },
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 30
              }
            },
            "required": [
              "round",
              "auto",
              "diagnosis",
              "note",
              "summary",
              "cause"
            ],
            "additionalProperties": false
          },
          "maxItems": 5
        },
        "lastReview": {
          "$comment": "The latest review, as the next review and fix prompts show it: its round, the version it reviewed, its verdict and its findings with severity, location and body (the location at most 300 characters, the body at most 1,500). A location is the host's text for where a finding points, kept as it came and empty when the finding points at nothing in particular. Up to 30 findings are kept: in the reviewer's order when there are no more, otherwise the blocking ones first, and `leftOut` counts those left out. Left out until the first review.",
          "type": "object",
          "properties": {
            "round": {
              "type": "integer"
            },
            "version": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "verdict": {
              "enum": [
                "approve",
                "request_changes"
              ]
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "enum": [
                      "blocking",
                      "suggestion"
                    ]
                  },
                  "location": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                },
                "required": [
                  "severity",
                  "location",
                  "body"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            },
            "leftOut": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "round",
            "version",
            "verdict",
            "findings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "started",
        "counted",
        "conflicts",
        "signatures",
        "findings",
        "criteria",
        "checklist"
      ],
      "additionalProperties": false
    },
    "used": {
      "$comment": "What the item's agents spent: tokens and seconds. `since` is when the item's time began for `budgets.item`: the start of its change after a plan's approval, a request for changes, or a person's fix or retry.",
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "common.schema.json#/$defs/tokens"
        },
        "seconds": {
          "type": "integer"
        },
        "since": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokens",
        "seconds",
        "since"
      ],
      "additionalProperties": false
    },
    "asked": {
      "type": "array",
      "items": {
        "enum": [
          "split",
          "titles",
          "parts",
          "fewer",
          "answers",
          "replan",
          "supersede"
        ]
      },
      "maxItems": 16
    },
    "parts": {
      "$comment": "The parts of a split, and how each ended, or null while it is open.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "state": {
            "anyOf": [
              {
                "enum": [
                  "accepted",
                  "noChange",
                  "dropped",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "policies": {
      "$comment": "The policies the running round started with, so that a change of the host's configuration applies from the next round. Empty while no round runs. Only the policies of policies.schema.json, each as it has it.",
      "type": "object",
      "properties": {
        "planApproval": {
          "$ref": "policies.schema.json#/properties/planApproval"
        },
        "reviewAfterFailingChecks": {
          "$ref": "policies.schema.json#/properties/reviewAfterFailingChecks"
        },
        "accept": {
          "$ref": "policies.schema.json#/properties/accept"
        },
        "fixRounds": {
          "$ref": "policies.schema.json#/properties/fixRounds"
        },
        "whenRoundsRunOut": {
          "$ref": "policies.schema.json#/properties/whenRoundsRunOut"
        },
        "conflicts": {
          "$ref": "policies.schema.json#/properties/conflicts"
        },
        "conflictRounds": {
          "$ref": "policies.schema.json#/properties/conflictRounds"
        },
        "splits": {
          "$ref": "policies.schema.json#/properties/splits"
        },
        "answers": {
          "$ref": "policies.schema.json#/properties/answers"
        },
        "afterFailure": {
          "$ref": "policies.schema.json#/properties/afterFailure"
        },
        "splitParts": {
          "$ref": "policies.schema.json#/properties/splitParts"
        },
        "splitDepth": {
          "$ref": "policies.schema.json#/properties/splitDepth"
        },
        "parentEnd": {
          "$ref": "policies.schema.json#/properties/parentEnd"
        },
        "retryWaits": {
          "$ref": "policies.schema.json#/properties/retryWaits"
        },
        "lostWaits": {
          "$comment": "Named so that the state knows every policy, but the engine never keeps it: it reads `lostWaits` as the host gives it at each loss.",
          "$ref": "policies.schema.json#/properties/lostWaits"
        },
        "budgets": {
          "$comment": "Named so that the state knows every policy, but the engine never keeps it: it reads `budgets` as the host gives it at each step.",
          "$ref": "policies.schema.json#/properties/budgets"
        },
        "agents": {
          "$comment": "Named so that the state knows every policy, but the engine never keeps it: it reads `agents` as the host gives it at each step.",
          "$ref": "policies.schema.json#/properties/agents"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "recentEvents": {
      "$comment": "The ids of the latest events that changed the state, newest last, at most 20. An event whose id is here changes nothing.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/eventId"
      },
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "item",
    "itemKind",
    "state",
    "change",
    "observed",
    "attention",
    "hold",
    "waits",
    "pending",
    "actors",
    "plan",
    "rounds",
    "used",
    "asked",
    "parts",
    "policies",
    "recentEvents"
  ],
  "additionalProperties": false
}
