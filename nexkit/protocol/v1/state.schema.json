{
  "$comment": "One work item's state document, which the host stores and passes back. It holds decisions, not prose. As JSON in ASCII with sorted keys and no spaces, it is at most 48,000 characters (`size.STATE_LIMIT`), so its base64 fits one GitHub comment: it keeps at most 10 questions of 6 options, 20 protected paths, 30 findings and 30 failure signatures, and the engine shortens its texts to fit, findings first (`size.fit`).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer"
    },
    "item": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "itemKind": {
      "enum": [
        "change",
        "reviewOnly"
      ]
    },
    "title": {
      "$comment": "The work item's title, at most 256 characters, as the latest request carried it: the parts of a split may not repeat it.",
      "type": "string"
    },
    "depth": {
      "$comment": "How many levels of parts the item is below the item first split, as the latest request carried it; 0 when left out.",
      "type": "integer"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "change": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "attention": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "common.schema.json#/$defs/attentionReason"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hold": {
      "type": "boolean"
    },
    "waits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "for": {
            "enum": [
              "start",
              "time",
              "blocker",
              "parts",
              "baseFailure",
              "requiredChecks",
              "usageLimit"
            ]
          },
          "until": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "on": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "for",
          "until",
          "on"
        ],
        "additionalProperties": false
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "type": "string"
          },
          "changeVersion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "changeVersion"
        ],
        "additionalProperties": false
      }
    },
    "actors": {
      "type": "object",
      "properties": {
        "plan": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "change": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "review": {
          "enum": [
            "engine"
          ]
        }
      },
      "required": [
        "plan",
        "change",
        "review"
      ],
      "additionalProperties": false
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/question"
              }
            },
            "criteria": {
              "type": "integer"
            },
            "tooLarge": {
              "type": "boolean"
            },
            "parts": {
              "type": "integer"
            },
            "noChange": {
              "type": "boolean"
            },
            "protectedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approved": {
              "type": "boolean"
            },
            "split": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "needs": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "key",
                  "title",
                  "needs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "text",
            "questions",
            "criteria",
            "tooLarge",
            "parts",
            "noChange",
            "protectedPaths",
            "approved",
            "split"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rounds": {
      "type": "object",
      "properties": {
        "started": {
          "type": "integer"
        },
        "counted": {
          "type": "integer"
        },
        "conflicts": {
          "type": "integer"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "blocking",
                  "suggestion"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "unmet",
              "unverifiable"
            ]
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "not_met",
              "not_applicable"
            ]
          }
        }
      },
      "required": [
        "started",
        "counted",
        "conflicts",
        "signatures",
        "findings",
        "criteria",
        "checklist"
      ],
      "additionalProperties": false
    },
    "used": {
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "common.schema.json#/$defs/tokens"
        },
        "since": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokens",
        "since"
      ],
      "additionalProperties": false
    },
    "asked": {
      "type": "array",
      "items": {
        "enum": [
          "split",
          "titles",
          "parts",
          "fewer",
          "answers"
        ]
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "state": {
            "anyOf": [
              {
                "enum": [
                  "accepted",
                  "noChange",
                  "dropped",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "item",
    "itemKind",
    "state",
    "change",
    "attention",
    "hold",
    "waits",
    "pending",
    "actors",
    "plan",
    "rounds",
    "used",
    "asked",
    "parts",
    "policies"
  ],
  "additionalProperties": false
}
