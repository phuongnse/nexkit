{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phuongnse/nexkit/protocol/v1/state.schema.json",
  "$comment": "One work item's state document, which the host stores and passes back. It holds decisions, not prose. As `protocol.size` measures it, JSON in UTF-8 with sorted keys and no spaces, it is at most 48,000 bytes, so that its base64 fits one GitHub comment. Each list the results and events fill has the most items it keeps (`maxItems`), and its texts are clipped as they come in. When a document would still pass the limit, the engine shortens the findings, the questions and options, the protected paths and the attention's text to fit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer"
    },
    "item": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "itemKind": {
      "enum": [
        "change",
        "reviewOnly"
      ]
    },
    "title": {
      "$comment": "The work item's title, at most 256 characters, as `created` gave it or a request gave it again: the parts of a split may not repeat it. Left out when no event gave it.",
      "type": "string",
      "maxLength": 256
    },
    "depth": {
      "$comment": "How many levels of parts the item is below the item first split, as `created` gave it or a request gave it again; 0 when left out.",
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "change": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/change"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed": {
      "$comment": "The latest observation of the item's change, from changeObserved or from the result of a publish or replace, or null. The engine reconciles the item with it after each event that changes the state (docs/engine.md#states).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "changeId": {
              "$ref": "common.schema.json#/$defs/observation/properties/changeId"
            },
            "version": {
              "$ref": "common.schema.json#/$defs/observation/properties/version"
            },
            "conflicts": {
              "$ref": "common.schema.json#/$defs/observation/properties/conflicts"
            },
            "merged": {
              "$ref": "common.schema.json#/$defs/observation/properties/merged"
            },
            "empty": {
              "$ref": "common.schema.json#/$defs/observation/properties/empty"
            }
          },
          "required": [
            "changeId",
            "version",
            "conflicts",
            "merged",
            "empty"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attention": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "common.schema.json#/$defs/attentionReason"
            },
            "text": {
              "type": "string"
            },
            "ref": {
              "$comment": "What the person decides on: the ref of the text that asked, for a question or an approval; null otherwise. A decision that names another changes nothing.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason",
            "text",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hold": {
      "type": "boolean"
    },
    "waits": {
      "type": "array",
      "items": {
        "$comment": "Each wait's id is new each time; a tick ends only a wait for a time (`time`, `usageLimit`, `requiredChecks`).",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "for": {
            "enum": [
              "start",
              "time",
              "usageLimit",
              "blocker",
              "parts",
              "baseFailure",
              "requiredChecks"
            ]
          },
          "until": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "on": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "for",
          "until",
          "on"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "pending": {
      "$comment": "The outbox: each action the engine answered, whole, until its result, its cancel or its loss.",
      "type": "array",
      "items": {
        "$ref": "action.schema.json"
      },
      "maxItems": 64
    },
    "actors": {
      "type": "object",
      "properties": {
        "plan": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "change": {
          "enum": [
            "engine",
            "person",
            "outside"
          ]
        },
        "review": {
          "enum": [
            "engine"
          ]
        }
      },
      "required": [
        "plan",
        "change",
        "review"
      ],
      "additionalProperties": false
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "questions": {
              "type": "array",
              "items": {
                "$comment": "A question as the state keeps it. `recommended` and `closes` count options from 1; 0 is none.",
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 6
                  },
                  "recommended": {
                    "type": "integer"
                  },
                  "closes": {
                    "type": "integer"
                  }
                },
                "required": [
                  "question",
                  "options",
                  "recommended"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            },
            "criteria": {
              "type": "integer"
            },
            "tooLarge": {
              "type": "boolean"
            },
            "parts": {
              "$comment": "How many parts the plan names, which may be more than `split` keeps.",
              "type": "integer"
            },
            "noChange": {
              "type": "boolean"
            },
            "protectedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "approved": {
              "type": "boolean"
            },
            "split": {
              "$comment": "The parts a split plan names, with the earlier parts each needs, by key.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "needs": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "maxItems": 9
                  }
                },
                "required": [
                  "key",
                  "title",
                  "needs"
                ],
                "additionalProperties": false
              },
              "maxItems": 10
            }
          },
          "required": [
            "text",
            "questions",
            "criteria",
            "tooLarge",
            "parts",
            "noChange",
            "protectedPaths",
            "approved",
            "split"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "$comment": "The questions of the implement or fix round that stopped as blocked and asked them, while they wait: `ref` is the agent action that asked, as attention names it, `stage` the stage that runs again with the engine's answers, and `noChange` whether the round, an implement round, found that no change is needed. Left out while no round's questions wait.",
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "stage": {
          "enum": [
            "implement",
            "fix"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$comment": "A question as the state keeps it. `recommended` and `closes` count options from 1; 0 is none. A round's question names in `replans` the options that only a new plan carries out.",
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 6
              },
              "recommended": {
                "type": "integer"
              },
              "closes": {
                "type": "integer"
              },
              "replans": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "maxItems": 6
              }
            },
            "required": [
              "question",
              "options",
              "recommended"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "noChange": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "stage",
        "items",
        "noChange"
      ],
      "additionalProperties": false
    },
    "rounds": {
      "type": "object",
      "properties": {
        "started": {
          "type": "integer"
        },
        "counted": {
          "type": "integer"
        },
        "conflicts": {
          "type": "integer"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "blocking",
                  "suggestion"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "unmet",
              "unverifiable"
            ]
          },
          "maxItems": 50
        },
        "checklist": {
          "type": "array",
          "items": {
            "enum": [
              "met",
              "not_met",
              "not_applicable"
            ]
          },
          "maxItems": 50
        },
        "baseFailure": {
          "$comment": "The item about a failure the base branch has that every failing check of the latest checks matches, as their result names it, or null: a fix round waits for it to close.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "recheck": {
          "$comment": "The version of the change that a fix round left as it was, having found the cause outside it, while it is the change's version: what still fails on it is a person's.",
          "$ref": "common.schema.json#/$defs/id"
        },
        "due": {
          "$comment": "An automatic fix round was decided and waits to be issued, for a hold or a failure the base branch has: it is counted when its run is issued, while `fixRounds` has one left by the policies given then.",
          "const": true
        },
        "automatic": {
          "$comment": "The fix round under way is an automatic one that `counted` holds, until its review ends: one that the engine stops before then gives its count back.",
          "const": true
        },
        "failing": {
          "$comment": "The checks that failed in the latest checks, each with its failure signature, kept as the signatures are: the checks after a fix round compare with them. Left out when none failed.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              }
            },
            "required": [
              "check",
              "signature"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "repeated": {
          "$comment": "The checks that failed with the same signature before and after the latest fix round, by name: the next automatic fix round diagnoses them first (`runAgent`'s `diagnose`). Left out when none did.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "fixed": {
          "$comment": "The version of the change that a fix round published, until its checks end: those checks are compared with the ones before it.",
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "started",
        "counted",
        "conflicts",
        "signatures",
        "findings",
        "criteria",
        "checklist"
      ],
      "additionalProperties": false
    },
    "used": {
      "$comment": "What the item's agents spent: tokens, seconds and US dollars.",
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "common.schema.json#/$defs/tokens"
        },
        "seconds": {
          "type": "integer"
        },
        "usd": {
          "type": "number"
        },
        "since": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokens",
        "seconds",
        "usd",
        "since"
      ],
      "additionalProperties": false
    },
    "asked": {
      "type": "array",
      "items": {
        "enum": [
          "split",
          "titles",
          "parts",
          "fewer",
          "answers",
          "replan"
        ]
      },
      "maxItems": 16
    },
    "parts": {
      "$comment": "The parts of a split, and how each ended, or null while it is open.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "state": {
            "anyOf": [
              {
                "enum": [
                  "accepted",
                  "noChange",
                  "dropped",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "policies": {
      "$comment": "The policies the running round started with, so that a change of the host's configuration applies from the next round. Empty while no round runs. Only the policies of policies.schema.json, each as it has it.",
      "type": "object",
      "properties": {
        "planApproval": {
          "$ref": "policies.schema.json#/properties/planApproval"
        },
        "reviewAfterFailingChecks": {
          "$ref": "policies.schema.json#/properties/reviewAfterFailingChecks"
        },
        "accept": {
          "$ref": "policies.schema.json#/properties/accept"
        },
        "fixRounds": {
          "$ref": "policies.schema.json#/properties/fixRounds"
        },
        "whenRoundsRunOut": {
          "$ref": "policies.schema.json#/properties/whenRoundsRunOut"
        },
        "conflicts": {
          "$ref": "policies.schema.json#/properties/conflicts"
        },
        "conflictRounds": {
          "$ref": "policies.schema.json#/properties/conflictRounds"
        },
        "splits": {
          "$ref": "policies.schema.json#/properties/splits"
        },
        "answers": {
          "$ref": "policies.schema.json#/properties/answers"
        },
        "splitParts": {
          "$ref": "policies.schema.json#/properties/splitParts"
        },
        "splitDepth": {
          "$ref": "policies.schema.json#/properties/splitDepth"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "recentEvents": {
      "$comment": "The ids of the latest events that changed the state, newest last, at most 20. An event whose id is here changes nothing.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/eventId"
      },
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "item",
    "itemKind",
    "state",
    "change",
    "observed",
    "attention",
    "hold",
    "waits",
    "pending",
    "actors",
    "plan",
    "rounds",
    "used",
    "asked",
    "parts",
    "policies",
    "recentEvents"
  ],
  "additionalProperties": false
}
