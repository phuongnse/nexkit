{
  "policies": {
    "planApproval": "autoWhenClean",
    "answers": "never",
    "splits": true
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true,
      "actions": []
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:implementRecommended"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "needPerson"
      ],
      "expect": {
        "attention.reason": "question"
      }
    },
    {
      "event": {
        "kind": "commented",
        "by": {
          "id": "someone",
          "role": "outside"
        }
      },
      "state": "awaitingApproval",
      "changed": false,
      "actions": []
    },
    {
      "event": {
        "kind": "commented"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ],
      "expect": {
        "pending.-1.stage": "plan"
      }
    }
  ]
}
