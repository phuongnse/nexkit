{
  "policies": {
    "planApproval": "autoWhenClean",
    "accept": "autoWhenPassed",
    "reviewAfterFailingChecks": "onlyAfterPassing",
    "conflicts": "resolve"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:implement"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "publish"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "publish",
        "result": {
          "change": {
            "id": "308",
            "version": "v1"
          },
          "refused": null
        }
      },
      "state": "checking",
      "changed": true,
      "actions": [
        "runChecks"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runChecks",
        "result": {
          "checks": [
            {
              "name": "test",
              "passed": false,
              "skipped": false,
              "signature": "fail test_x",
              "knownBaseFailure": false
            }
          ]
        }
      },
      "state": "fixing",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:fixQuestions"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "needPerson"
      ]
    },
    {
      "event": {
        "kind": "answered"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "runAgent"
      ],
      "expect": {
        "pending.1.id": "a7.1",
        "pending.1.stage": "plan",
        "pending.1.changeVersion": "v1"
      }
    },
    {
      "event": {
        "kind": "conflict",
        "changeVersion": "v1"
      },
      "state": "fixing",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ],
      "expect": {
        "pending.1.kind": "cancel",
        "pending.1.action": "a7.1",
        "pending.2.stage": "fix",
        "rounds.conflicts": 1
      }
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "a7.1",
        "result": "@agent:plan"
      },
      "state": "fixing",
      "changed": false,
      "actions": []
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:fix"
      },
      "state": "fixing",
      "changed": true,
      "actions": [
        "publish"
      ]
    }
  ]
}
