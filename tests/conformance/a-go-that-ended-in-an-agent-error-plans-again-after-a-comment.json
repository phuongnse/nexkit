{
  "policies": {
    "planApproval": "autoWhenClean",
    "afterFailure": "replan"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true,
      "actions": []
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@error"
      },
      "state": "failed",
      "changed": true,
      "actions": [
        "needPerson"
      ],
      "expect": {
        "attention.reason": "roundFailed"
      }
    },
    {
      "event": {
        "kind": "commented",
        "by": {
          "id": "eve",
          "role": "outside"
        }
      },
      "state": "failed",
      "changed": false,
      "actions": []
    },
    {
      "event": {
        "kind": "commented"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ]
    }
  ]
}
