{
  "policies": {
    "accept": "autoWhenPassed",
    "conflicts": "redo"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:implement"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "publish"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "publish",
        "result": {
          "change": {
            "id": "308",
            "version": "v1"
          },
          "refused": null
        }
      },
      "state": "checking",
      "changed": true,
      "actions": [
        "runChecks"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runChecks",
        "result": {
          "checks": [
            {
              "name": "test",
              "passed": true,
              "skipped": false,
              "signature": null,
              "knownBaseFailure": false
            }
          ]
        }
      },
      "state": "reviewing",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:review"
      },
      "state": "accepting",
      "changed": true,
      "actions": [
        "accept"
      ]
    },
    {
      "event": {
        "kind": "changeObserved",
        "conflicts": true
      },
      "state": "working",
      "changed": true,
      "actions": [
        "cancel",
        "replaceChange"
      ]
    },
    {
      "event": {
        "kind": "changeObserved",
        "version": "v2"
      },
      "state": "working",
      "changed": true,
      "actions": []
    },
    {
      "event": {
        "kind": "actionLost",
        "action": "replaceChange"
      },
      "state": "failed",
      "changed": true,
      "actions": [
        "needPerson"
      ],
      "expect": {
        "attention.reason": "outage",
        "change.version": "v1"
      }
    }
  ]
}
