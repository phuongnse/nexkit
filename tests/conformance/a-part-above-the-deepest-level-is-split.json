{
  "policies": {
    "planApproval": "autoWhenClean",
    "accept": "autoWhenPassed"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan",
        "depth": 2
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planSplit"
      },
      "state": "split",
      "changed": true,
      "actions": [
        "show",
        "createParts"
      ]
    }
  ]
}