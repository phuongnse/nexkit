{
  "policies": {
    "planApproval": "autoWhenClean",
    "splits": true
  },
  "steps": [
    {
      "event": {
        "kind": "created",
        "depth": 3
      },
      "state": "new",
      "changed": true,
      "expect": {
        "depth": 3
      }
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planSplit"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "show",
        "needPerson"
      ],
      "expect": {
        "attention.reason": "splitDepth"
      }
    },
    {
      "event": {
        "kind": "planApproved"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ],
      "expect": {
        "parts": []
      }
    }
  ]
}