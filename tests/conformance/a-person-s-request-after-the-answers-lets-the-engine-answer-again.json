{
  "policies": {
    "planApproval": "autoWhenClean",
    "splits": true,
    "answers": "recommended"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planRecommended"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "show",
        "show",
        "runAgent"
      ],
      "expect": {
        "asked": [
          "answers"
        ]
      }
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planRecommended"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "show",
        "needPerson"
      ],
      "expect": {
        "attention.reason": "askedAgain"
      }
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ],
      "expect": {
        "asked": []
      }
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planRecommended"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "show",
        "show",
        "runAgent"
      ]
    }
  ]
}