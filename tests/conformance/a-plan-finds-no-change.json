{
  "policies": {
    "planApproval": "autoWhenClean"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planNoChange"
      },
      "state": "noChange",
      "changed": true,
      "actions": [
        "show",
        "close"
      ]
    }
  ]
}