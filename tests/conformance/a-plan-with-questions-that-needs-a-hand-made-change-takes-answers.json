{
  "policies": {
    "planApproval": "autoWhenClean"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planProtectedQuestions"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "show",
        "needPerson"
      ],
      "expect": {
        "attention.reason": "handMadeChange"
      }
    },
    {
      "event": {
        "kind": "answered"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ]
    }
  ]
}