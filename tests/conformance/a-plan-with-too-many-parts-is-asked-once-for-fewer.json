{
  "policies": {
    "planApproval": "autoWhenClean",
    "accept": "autoWhenPassed"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planManyParts"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "show",
        "runAgent"
      ],
      "asked": [
        "fewer"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planManyParts"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "show",
        "needPerson"
      ],
      "attention": "tooManyParts"
    },
    {
      "event": {
        "kind": "commented"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planSplit"
      },
      "state": "split",
      "changed": true,
      "actions": [
        "show",
        "createParts"
      ],
      "asked": [
        "fewer"
      ]
    }
  ]
}