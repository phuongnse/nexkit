{
  "policies": {
    "planApproval": "autoWhenClean",
    "splits": true
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planManyParts"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "show",
        "runAgent"
      ],
      "expect": {
        "asked": [
          "fewer"
        ]
      }
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planManyParts"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "show",
        "needPerson"
      ],
      "expect": {
        "attention.reason": "tooManyParts"
      }
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planSplit"
      },
      "state": "split",
      "changed": true,
      "actions": [
        "show",
        "createParts"
      ]
    }
  ]
}