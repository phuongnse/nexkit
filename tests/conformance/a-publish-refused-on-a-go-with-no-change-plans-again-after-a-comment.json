{
  "policies": {
    "planApproval": "autoWhenClean",
    "afterFailure": "replan"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true,
      "actions": []
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:implement"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "publish"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "publish",
        "result": {
          "change": null,
          "refused": "The branch is protected.",
          "observed": null
        }
      },
      "state": "failed",
      "changed": true,
      "actions": [
        "needPerson"
      ],
      "expect": {
        "attention.reason": "roundFailed"
      }
    },
    {
      "event": {
        "kind": "commented"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "cancel",
        "runAgent"
      ]
    }
  ]
}
