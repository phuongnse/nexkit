{
  "policies": {
    "accept": "autoWhenPassed",
    "conflicts": "resolve"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:implement"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "publish"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "publish",
        "result": {
          "change": {
            "id": "308",
            "version": "v1"
          },
          "refused": null
        }
      },
      "state": "checking",
      "changed": true,
      "actions": [
        "runChecks"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runChecks",
        "result": {
          "checks": [
            {
              "name": "test",
              "passed": true,
              "skipped": false,
              "signature": null,
              "knownBaseFailure": false
            }
          ]
        }
      },
      "state": "reviewing",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:review"
      },
      "state": "accepting",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "accept",
        "result": {
          "accepted": false,
          "refusal": "conflict",
          "text": "Refused: conflict."
        }
      },
      "state": "fixing",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    }
  ]
}