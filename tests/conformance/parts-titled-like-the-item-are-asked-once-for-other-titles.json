{
  "policies": {
    "planApproval": "autoWhenClean",
    "accept": "autoWhenPassed"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "plan",
        "title": "A work item"
      },
      "state": "planning",
      "changed": true
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planRepeatsTheTitle"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "show",
        "runAgent"
      ],
      "asked": [
        "titles"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planRepeatsTheTitle"
      },
      "state": "awaitingApproval",
      "changed": true,
      "actions": [
        "show",
        "needPerson"
      ],
      "attention": "partTitles"
    },
    {
      "event": {
        "kind": "commented"
      },
      "state": "planning",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:planSplit"
      },
      "state": "split",
      "changed": true,
      "actions": [
        "show",
        "createParts"
      ]
    }
  ]
}