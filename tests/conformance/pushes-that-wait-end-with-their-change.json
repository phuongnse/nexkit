{
  "policies": {
    "accept": "autoWhenPassed",
    "conflicts": "redo"
  },
  "steps": [
    {
      "event": {
        "kind": "created"
      },
      "state": "new",
      "changed": true
    },
    {
      "event": {
        "kind": "requested",
        "what": "go"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:implement"
      },
      "state": "working",
      "changed": true,
      "actions": [
        "publish"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "publish",
        "result": {
          "change": {
            "id": "308",
            "version": "v1"
          },
          "refused": null
        }
      },
      "state": "checking",
      "changed": true,
      "actions": [
        "runChecks"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runChecks",
        "result": {
          "checks": [
            {
              "name": "test",
              "passed": true,
              "skipped": false,
              "signature": null,
              "knownBaseFailure": false
            }
          ]
        }
      },
      "state": "reviewing",
      "changed": true,
      "actions": [
        "runAgent"
      ]
    },
    {
      "event": {
        "kind": "changePushed",
        "changeVersion": "v3",
        "previousVersion": "v2"
      },
      "state": "reviewing",
      "changed": true,
      "actions": [],
      "expect": {
        "pushes": [
          {
            "previousVersion": "v2",
            "changeVersion": "v3"
          }
        ]
      }
    },
    {
      "event": {
        "kind": "changePushed",
        "changeVersion": "v3",
        "previousVersion": "v2",
        "id": "push-again"
      },
      "state": "reviewing",
      "changed": false,
      "actions": []
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "runAgent",
        "result": "@agent:review"
      },
      "state": "accepting",
      "changed": true,
      "actions": [
        "accept"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "accept",
        "result": {
          "accepted": false,
          "refusal": "conflict",
          "text": ""
        }
      },
      "state": "working",
      "changed": true,
      "actions": [
        "replaceChange"
      ]
    },
    {
      "event": {
        "kind": "actionFinished",
        "action": "replaceChange",
        "result": {
          "change": {
            "id": "309",
            "version": "w1"
          }
        }
      },
      "state": "working",
      "changed": true,
      "actions": [
        "runAgent"
      ],
      "expect": {
        "pushes": []
      }
    }
  ]
}
